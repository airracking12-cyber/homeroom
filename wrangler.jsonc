{
  "name": "homeroom",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // These two are public (the publishable key is meant to be public). The AI keys are NOT here; add them as Secrets in Cloudflare.
  "vars": {
    "SUPABASE_URL": "https://vvhkjgcnbhzqyxgsdzgq.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_VzvwYBKX6TTDOqVq5J_RQA_KNd-CR5K"
  },
  // Study-assistant rate limit: 20 AI calls per minute per signed-in student (period can only be 10 or 60 seconds).
  // namespace_id is any number that is unique among your Cloudflare rate limiters.
  "ratelimits": [
    { "name": "AI_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ]
}
